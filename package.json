{
  "name": "price-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Local Randewoo price tracker for 1.5 ml variants",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node run.js",
    "collect": "node run.js --once",
    "lab": "node scripts/test-lab.js",
    "prelab:verify": "npm run build",
    "lab:verify": "node scripts/verify-test-lab.js",
    "test:backend": "node --test tests/*.test.js",
    "test:frontend": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:backend && npm run test:frontend",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --check run.js && node --check src/client.js && node --check src/database.js && node --check src/service.js && node --check src/web.js && node --check scripts/build-frontend.js && node --check scripts/test-lab.js && node --check scripts/test-lab/fixture.js && node --check scripts/verify-test-lab.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
